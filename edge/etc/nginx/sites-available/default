upstream app {
    least_conn;
    server 10.10.0.3:3000 max_fails=3 fail_timeout=10s;
    server 10.10.0.4:3000 max_fails=3 fail_timeout=10s;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=perip:10m rate=10r/s;

server {
    listen 80;
    server_name example.com.au www.example.com.au;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com.au www.example.com.au;

    ssl_certificate     /etc/letsencrypt/live/example.com.au/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com.au/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    server_tokens off;
    client_max_body_size 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        limit_req zone=perip burst=20 nodelay;

        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
